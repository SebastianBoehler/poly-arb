{
  "name": "poly-arb",
  "version": "1.0.0",
  "description": "Real-time Polymarket arbitrage ladder bot for crypto up/down 15m markets",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "trading": "bun run src/strategies/trading.ts",
    "copy-trade": "bun run src/strategies/copy-trade.ts",
    "market-maker": "bun run src/strategies/market-maker.ts",
    "analyze": "bun run src/scripts/analyze-markets.ts",
    "collect": "bun run src/scripts/collect-market-data.ts",
    "plots": "python scripts/analyze_markets.py --data-dir ./data --out-dir market-plots",
    "stats": "bun run src/stats/stats.ts",
    "cpp:update-client": "./scripts/update-cpp-client.sh",
    "cpp:configure": "cmake -S cpp -B cpp/build -DCMAKE_BUILD_TYPE=Release",
    "cpp:build": "cmake --build cpp/build -j 4",
    "cpp:test": "ctest --test-dir cpp/build --output-on-failure",
    "discovery:cpp": "./cpp/build/discovery_mode --max 50 --iterations 1",
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@ethersproject/wallet": "^5.8.0",
    "@polymarket/builder-relayer-client": "^0.0.8",
    "@polymarket/clob-client": "^5.1.3",
    "@polymarket/real-time-data-client": "^1.4.0",
    "dotenv": "^17.2.3",
    "viem": "^2.43.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "bun-types": "latest",
    "typescript": "^5.0.0"
  },
  "keywords": ["polymarket", "arbitrage", "crypto", "trading", "websocket"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SebastianBoehler/poly-arb"
  }
}
